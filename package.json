{
  "name": "youtube-lyrics",
  "version": "1.0.4",
  "private": true,
  "description": "Browser extension that shows song lyrics next to YouTube videos.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Firefox0/Youtube-Lyrics.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/webextension-polyfill": "^0.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^5.0.2"
  }
}
